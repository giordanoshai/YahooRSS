# ============================================================
# YahooRSS 环境变量配置模版
# 复制一份并重命名为 .env，填入你的密钥即可运行
# ============================================================

# --- 数据库配置 (本地 SQLite3，默认开箱即用，无需配置云数据库) ---
SQLITE_DB_PATH=yahoonews.db

# --- 阿里云 DashScope / Qwen API（用于快速评估、翻译与摘要） ---
# 获取地址: https://dashscope.console.aliyun.com/
QWEN_API_KEY=sk-your-dashscope-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- OpenRouter API（用于每日买方宏观大盘研报，支持多种开源及旗舰模型） ---
# 获取地址: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- 默认模型配置 ---
DEFAULT_LLM=qwen3.5-flash
EVALUATION_MODEL=deepseek-v4-flash
SUMMARIZATION_MODEL=deepseek-v4-flash
DAILY_SUMMARY_MODEL=nvda-nemotron-120b

# --- 网络代理配置（如在国内服务器访问 Yahoo Finance 或 OpenRouter 时需配置） ---
# HTTP_PROXY=http://127.0.0.1:7890
# SOCKS5_PROXY=socks5://127.0.0.1:7890

# --- RSS 输出路径与保留策略 ---
RSS_NEWS_PATH=yahoonews_rss.xml
RSS_SUMMARY_PATH=summary_rss.xml
RSS_RETENTION_DAYS=2

# --- 抓取与并发参数 ---
SCRAPE_MAX_THREADS=4
SCRAPE_INTERVAL_MINUTES=3

# --- 兜底自选股（用于模式 B 二次筛选，逗号分隔） ---
DEFAULT_WATCHLIST=SPY,QQQ,AAPL,NVDA,MSFT,TSLA,AMZN,GOOGL,META
